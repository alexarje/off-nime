  year = {2022},
  doi = {10.5281/zenodo.5885652},
  abstract = {The COVID-19 pandemic has created both challenges and opportunities for live coding ensembles. These are particularly acute for ensemble which make use of networked live coding systems, such as the Birmingham Ensemble for Electroacoustic Research (BEER), and the Istanbul Coding Ensemble (ICE). This paper looks at two local area network works developed by BEER, and how they were adapted for internet presentation during lockdown, and discusses some possible future directions for collaborative work.&nbsp;}
