@inproceedings{SuzukiPerformance2000,
    author = {Kenji Suzuki and Keishiro Tabe and Shuji Hashimoto},
    title = {A mobile robot platform for music and dance performance},
    pages = {539-542},
    booktitle = {Proceedings of the International Computer Music Conference},
    year = {2000},
    publisher = {Berlin},
    address = {Germany},
    url = {https://quod.lib.umich.edu/i/icmc/bbp2372.2000.223/--mobile-robot-platform-for-music-and-dance-performance?view=image},
    abstract = {Robot can be effectively used for musical performances with motion because it can move around while generating sound and music according to the human performer’s movement and the environmental sound. In such performance systems that users can get feedback for the emotional activation in terms of sound, music, image and motion. In the developed system, all the data are exchanged through the MIDI network among the components and the external MIDI controller devices. Therefore, the user can easily associate with all the components including not only the music and image generation but also the motion control of the mobile robot. The proposed approach to equip musical instruments with an autonomous mobile ability is providing a new computer music performance in real world.}
}


