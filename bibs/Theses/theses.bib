@phdthesis{thesis:florio2026thejointdidactic,
  author = {Florio, Paola},
  title = {The Joint Didactic Action to build the art of dance : Study of the Rite of Spring of Pina Bausch},
  school = {Université de Brest (2025-....)},
  year = {2026},
  doi = {10.70675/0d985449zd261z4edczbcb8zc2d996d98509},
  abstract = {The thesis « Joint Didactic Action to build the art of dance. Study of the Rite of Spring of Pina Bausch » is based on the JATD (CDpE, 2019, 2024) which is a theoretical framework for didactic analysis, in continuity with other works conducted in the field of dance (e.g., Messina, 2017, 2019). We used the notions of imitation game and self-milieu to understand the context of dance study. The aim of the research is to help dancers who are looking for aprofessional training in dance, and to preserve the transmission of choreographies with an exploration of dance movement written coding. The research field involves two institutions of different sizes: ECD, School and Conservatory of Dance in Aosta, ltaly, and TMA, Torino Musical Academy in Turin, ltaly; in both of them we wanted to study what is transmitted and how what is transmitted is taught. The results were presented with several didactic devices, among others the PFRD, Photographic and Filmic Representations in Dance, which helps keep the material trace of a learning situation. We studied in particular the collective construction of interpretation, breathing, dance gestures and the position in space of a synthesis of choreography. This work has the ambition to create a cooperation between the scientific community of researchers and dance practitioners, to leam to work together in a participatory way.},
  collection = {Theses},
  note = {Found in theses.fr; selected by similarity to the archives; NIME-topic probability 0.72}
}

@phdthesis{thesis:richthoff2026warpingsoundwith,
  author = {Richthoff, Lukas},
  title = {Warping sound with gesturing : sensor-based tracking for expressive control of guitar effects in live performance},
  school = {KTH Royal Institute of Technology},
  year = {2026},
  url = {http://urn.kb.se/resolve?urn=urn:nbn:se:bth-30077},
  abstract = {Guitar pedals are used conventionally in a live performance, but restricts where and how these effects are controlled. Additionally, most effect-controlling devices lack the expressive, visual and communicative aspect, or more specifically, emphasizing the representation of the effects and giving them a greater purpose, as opposed to practical and efficient use. Which suggests the use of gesture control in a guitar performance and seeing it as an added tool for expression beyond conventional guitar practice. Previous works have researched gesture control technology for guitar use, but the research for this paper focuses on expression and movement, pointing towards increased freedom of movement in order to allow sound-producing gestures that excludes the guitar itself and never practiced normally. Furthermore, the design makes use of hand and wrist movement that are tracked by a glove with a mounted inertial measurement unit, which in turn control effect parameters based on the rotations. It also deactivates when picking, meaning that traditional playing is possible and gesture control can be used when notes ring out or when playing legato. This resulted in a variety of different manoeuvres alongside the guitar performance, including short fast swinging motions between picking and gesturing and slow careful movements while playing legato simultaneously. These interactions suggested a design that introduced complexity, emphasized dance-like motion, and promoted congruent gesturing.},
  collection = {Theses},
  note = {Found in OpenAlex; selected by similarity to the archives; NIME-topic probability 0.98}
}

