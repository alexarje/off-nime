@phdthesis{thesis:lavastre2026instrumentalinte,
  author = {Lavastre, Benjamin},
  title = {Instrumental Interaction V pour 3 Karlax, ensemble et électronique},
  school = {McGill University},
  year = {2026},
  doi = {10.82308/49294},
  abstract = {This thesis presents the creative process of Instrumental Interaction V for 3 Karlax, ensemble, and electronics. This piece was premiered on February 21, 2025, at the Multi-Media Room (MMR) by ensemble Éclat and Karlax players D. Andrew Stewart, Tom Mays, and Huizi Wang as part of the Montreal Nouvelles Musiques 2025 festival. The Karlax is a clarinet-shaped digital musical instrument (DMI) whose main sensors are ten continuous keys, eight velocity pistons, a rotary axis, and an inertial unit with three axes of accelerometers and gyroscopes. After over fifty years of creations with DMIs and the first conclusive interfaces such as Michel Waisvisz's The Hands conceived in the 1980s, digital musical instruments remain little integrated into contemporary musical practices (Ferguson &amp; Wanderley 2010). This thesis first addresses the main issues of using DMIs in a mixed context with acoustic instruments. A DMI consists of three parts: an interface, a sound-generating system, and mapping strategies that associate interface data with sound synthesis parameters (Miranda &amp; Wanderley 2006). One of the main differences between an acoustic instrument and a DMI lies in the sound-gesture relationship. For an acoustic instrument, this relationship is determined by the physical behaviors of vibrating structures (e.g. strings, membranes, air columns, etc.), whereas for a DMI, this relationship is to be constructed by composers and performers. This particularity implies elements of language specific to DMIs, such as an emphasis on gesture, both physical (instrumental or choreographed) and metaphorical (Smalley 1997), an intermodal perception that is both acoustic and visual, a parametric writing, specific instrumental interactions described by metaphors drawn from computer music and human-computer interaction field, and an original conception of musical time. In addition, the use of DMIs involves a range of techniques of its own, such as data conditioning to expand the gestural vocabulary, techniques linked to the mapping phase (scaling, smoothing, adding functions, morphing, etc.), sound synthesis, real-time sound processing, spatialization techniques, and notation. Depending on the project, notation techniques can be either prescriptive, describing the performer's actions, or descriptive, commenting on the sound phenomenon. Finally, this first part presents in detail the Karlax interface, its main composition and interpretation strategies, and its originality to other interfaces.The second part focuses on the creative process behind Instrumental Interaction V. It goes back over the main compositional strategies and offers an analysis of the formal structure organized around the superimposition of layers of writing levels. Indeed, the piece is built around several 'gestures' and situations that encourage interaction between the Karlax and acoustic instruments. The analysis also looks at the instrumental techniques, sound synthesis strategies, mapping, and },
  collection = {Theses},
  note = {Found in DataCite; selected by similarity to the archives; NIME-topic probability 0.96}
}

@phdthesis{thesis:turza2026modificationofan,
  author = {Turza, Šimon},
  title = {Modification of an existing Fatar TP9S musical keyboard to sense key position with linear Hall sensors},
  school = {Brno University of Technology},
  year = {2026},
  url = {https://hdl.handle.net/11012/259853},
  abstract = {This master’s thesis deals with the modification of an existing Fatar TP9S musical keyboard to replace the original contact system with contactless key position sensing using linear Hall sensors. The work includes the design and optimization of a magnetic circuit, which was verified using magnetostatic simulations in the FEMM 4.2 software. Furthermore, it describes the development of data acquisition hardware and the programming of a control unit with a Raspberry Pi Pico 2 microcontroller for communication via the USB-MIDI interface. The modification also includes the design and realization of mechanical flexible elements for the aftertouch function made of TPU material. The result of the thesis is a fully functional MIDI controller that supports various operating modes, including MIDI Polyphonic Expression, with low average latency.},
  collection = {Theses},
