@article{davidson1976haptic,
	title = {Haptic perception},
	author = {Davidson, Philip W},
	journal = {Journal of pediatric psychology},
	volume = {1},
	number = {3},
	pages = {21--25},
	year = {1976},
	publisher = {Oxford University Press},
	doi = {10.1093/jpepsy/1.3.21},
	abstract = {A selective review of some issues concerning haptic perception and blindness is provided. The earliest concern, historically, was whether the blind developed more acute tactual sense reception. Interest has shifted to the more efficient patterns of haptic exploratory activity engaged in by the blind, and how these develop in the blind child. Some clinical, educational, and rehabilitative elements are beginning to emerge from this research. This paper is an attempt to review briefly but comprehensively some issues and data regarding haptic perception in general and relationship between haptics and blindness in particular. My intention is to formulate the problem in such a way as to reduce the gap between the basic theory and application from which this area of research seems to suffer more than most. The paper is not intended to exhaustively review the literature; several reviews are available (Davidson, Note 1; 1972b; Jones 1975; Warren, in press).}
}


@article{fletcher1996force,
	author = {Fletcher, R.},
	title = {Force Transduction Materials for Human-Technology Interfaces},
	journal = {IBM Systems Journal},
	volume = {35},
	number = {3&4},
	pages = {630--638},
	year = {1996},
	doi = {10.1147/sj.353.0630},
	abstract = {Various approaches to sensing forces and generating forces are presented in the context of building human-technology interfaces capable of communicating force information. addressing the need for various types of force transducers, relevant classes of materials are reviewed, including smart materials, electronic polymers, and magnetic materials. basic physical limits and design trade-offs are given for building force sensors and actuators from these materials. in addition, the possibility of using force transduction as a means of generating electrical energy is also briefly discussed. finally, two brief illustrative examples, “power shoes” and “deformable surfaces,” are also presented.}
}


