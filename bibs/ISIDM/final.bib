@article{wechsler1997computers,
	author = {Wechsler, R.},
	title = {Computers and Art: a Dancer's Perspective},
	journal = {IEEE Technology and Society Magazine},
	year = {1997},
	doi = {10.1109/44.605946},
	abstract = {When we speak of the role of computers in art, we could be referring to quite different things: art that is concerned with computers, or art that is merely created using computers. The computer's application to dance may indeed be viable, but as the influence of computers continues to grow, changing the world in ways we can hardly imagine today, it becomes a task for all of us-though perhaps especially for artists-to look very carefully at these strange "tool-like" things, to turn them slowly in our hands, heads tilted.}
