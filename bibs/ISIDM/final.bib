@article{deng2011real,
	author = {Deng, L. Q. and Leung, H. and Gu, N. J. and Yang, Y.},
	title = {Real-time mocap dance recognition for an interactive dancing game},
	journal = {Computer Animation and Virtual Worlds},
	volume = {22},
	number = {2-3},
	pages = {229--237},
	year = {2011},
	doi = {10.1002/cav.397},
	abstract = {In this paper, we present an interactive dancing game based on motion capture technology. We address the problem of real‐time recognition of the user's live dance performance in order to determine the interactive motion to be rendered by a virtual dance partner. The real‐time recognition algorithm is based on a human body partition indexing scheme with flexible matching to determine the end of a move as well as to detect unwanted motion. We show that the system can recognize the live dance motions of users with good accuracy and render the interactive dance move of the virtual partner. Copyright © 2011 John Wiley &amp; Sons, Ltd.}
}


