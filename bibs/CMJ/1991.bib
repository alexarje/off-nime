@Article{pennycook91,
author = {Pennycook, Bruce},
URL = {https://www.jstor.org/stable/3680762},
title = {Machine Songs II: The PRAESCIO Series - Composition-Driven Interactive
Software},
journal = {Computer Music Journal},
volume = {15},
number = {3},
year = {1991},
pages = {16--26},
doi = {10.2307/3680762},
abstract = {This paper describes the PRAESCIO series of compositions for one or more performers and interactive, computer-controlled, MIDI system. A chronological account of the process of composing, rehearsing, and performing the five works in the series is provided to illustrate the development of the MIDI-LIVE software system. A critical evaluation of the problems and solutions encountered over the three-year period of development accompanies the presentation of each phase and composition.}
}
