@Article{haken98,
author = {Haken, Lippold and Tellman, Ed and Wolfe, Patrick},
URL = {https://www.jstor.org/stable/3681043},
title = {An Indiscrete Music Keyboard},
journal = {Computer Music Journal},
volume = {22},
number = {1},
year = {1998},
pages = {30--48},
doi = {10.2307/3681043},
abstract = {The Continuum is a new type of polyphonic music performance device. Its playing surface is approximately the same size as a traditional synthesizer keyboard, but instead of using discrete keys, it tracks the positions on the x-, y-, and z-axes independently for up to ten simultaneous notes. Its synthesis algorithm implements continuous timbre morphing on pre-analyzed sampled sounds. In this article, we describe a complete musical instrument, including a mechanical input device and synthesis algorithms, along with their implementations.}
}
